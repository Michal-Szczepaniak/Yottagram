[Desktop Entry]
Type=Application
X-Nemo-Application-Type=generic
Icon=yottagram-slack
Exec=dbus-send --type="method_call" --dest=com.verdanditeam.yottagram.slack / com.verdanditeam.yottagram.openApp
Name=Yottagram Slack

[X-Sailjail]
Permissions=Internet;Audio;Location;Microphone;UserDirs;RemovableMedia
OrganizationName=com.verdanditeam
ApplicationName=Yottagram
Sandboxing=Disabled
